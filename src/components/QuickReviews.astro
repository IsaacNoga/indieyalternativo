---
import { reviews } from "../assets/mockreviews";
import ArtistCard from "./ArtistCard.astro";
import ReviewCard from "./ReviewCard.astro";
import Star from "./Star.astro";

const frontReviews = reviews;

const topArtist = [
  {
    src: "/img/karolg.webp",
    name: "KAROL G",
    rate: 1,
    link: "/",
  },
  {
    src: "/img/arca.webp",
    name: "Arca",
    rate: 2,
    link: "/",
  },
  {
    src: "/img/badbunny-verano.webp",
    name: "Badbunny",
    rate: 3,
    link: "/",
  },
  {
    src: "/img/tyler-chromakopia.webp",
    name: "Tyler The Creator",
    rate: 4,
    link: "/",
  },
  {
    src: "/img/kendrick-gnx.webp",
    name: "Kendrick Lammar",
    rate: 5,
    link: "/",
  },
];
---

<div
  class="w-full min-h-1/2 lg:h-full flex flex-col justify-around pb-10 bg-red-500"
>
  <div class="flex flex-col gap-1 lg:h-1/2">
    <div class="flex flex-row gap-1 pt-4 md:px-6">
      <Star size={34} />
      <p class="text-4xl title">TOP REVIEWS DE LA SEMANA</p>
    </div>
    <div class="w-full border border-black my-2"></div>
    <div
      class="w-full flex flex-col lg:flex-row lg:overflow-x-auto scrollbar-none"
    >
      {
        frontReviews.slice(0, 9).map((review) => (
          <ReviewCard
            src={review?.mediaRoute}
            title={review?.title}
            rate={review?.rate}
          />
        ))
      }
    </div>
  </div>
  <div class="flex flex-col gap-1 lg:h-1/2">
    <div class="flex flex-row gap-1 pt-4 md:px-6">
      <Star size={34} />
      <p class="text-4xl title">TOP ARTISTAS DE LA SEMANA</p>
    </div>
    <div class="w-full border border-black my-2"></div>
    <div
      class="w-full flex flex-col lg:flex-row lg:overflow-x-auto scrollbar-none"
    >
      {
        topArtist.map((review) => (
          <ArtistCard
            src={review?.src}
            name={review?.name}
            rate={review?.rate}
          />
        ))
      }
    </div>
  </div>
</div>
