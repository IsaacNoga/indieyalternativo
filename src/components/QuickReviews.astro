---
import ReviewCard from "./ReviewCard.astro";
import Star from "./Star.astro";

const frontReviews = [
  {
    src: "/img/karlog.webp",
    title: "NO ME ARREPIENTO DE SENTIR TANTO",
    subtitle: "KAROL G",
    rate: 9.0,
    link: "/",
  },
  {
    src: "/img/arca.webp",
    title: "XXXX",
    subtitle: "Arca",
    rate: 5.3,
    link: "/",
  },
  {
    src: "/img/charliexcx.webp",
    title: "Music, Fashion, Film",
    subtitle: "Charlie XCX",
    rate: 10,
