---

<div class="w-full h-full flex flex-col p-0 bg-red-500">
  <div class="flex flex-col gap-1">
    <div class="flex flex-row gap-1 pt-4 md:px-6">
      <Star size={34} />
      <p class="text-4xl title">MÁS REVIEWS</p>
    </div>
    <div class="w-full border border-black my-2"></div>
    <div class="w-full flex flex-row overflow-x-auto scrollbar-none">
      {
        frontReviews.map((review) => (
          <ReviewCard
            src={review?.src}
            title={review?.title}
            rate={review?.rate}
          />
        ))
      }
      {
        frontReviews.map((review) => (
          <ReviewCard
            src={review?.src}
