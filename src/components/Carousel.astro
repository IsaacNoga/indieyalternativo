---
import Grain from "./Grain.astro";
import Star from "./Star.astro";

export interface Slide {
  mediaRoute: string;
  alt?: string;
  title: string;
  subtitle: string;
  link?: string;
  rate?: number;
  resume: string;
  genre: string;
}

interface Props {
  slides: Slide[];
  interval?: number;
}

const { slides, interval = 10000 } = Astro.props;
const uid = crypto.randomUUID().slice(0, 8);
---

<div
  class="carousel relative w-full h-1/2 md:h-full overflow-hidden"
  data-carousel-id={uid}
  data-interval={interval}
>
  {
    slides.map((slide, i) => (
      <div
        class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out"
        style={`opacity: ${i === 0 ? 1 : 0};`}
        data-index={i}
      >
        <img
          src={slide.mediaRoute}
          alt={slide.alt ?? ""}
          class="w-full h-full object-cover brightness-40"
        />

        {(slide.title || slide.link || slide?.subtitle) && slide?.rate && (
          <div class="h-full w-full absolute z-20 bottom-0 flex justify-between gap-6 md:py-30 md:px-20">
            <div class="h-1/2 mt-auto flex flex-col gap-2 justify-end p-5 w-2/3">
              <div class="flex flex-col gap-6">
                <div class="flex flex-row gap-1">
                  <p class="text-red-500 font-extrabold md:text-2xl">
                    {slide.genre}
                  </p>
                </div>
                <div class="flex flex-col gap-2">
                  <p
                    class={
                      "w-full text-white text-lg text-justify md:text-6xl title"
                    }
                  >
                    {slide.title}
                  </p>
                  <p class="text-white text-lg md:text-4xl font-extrabold">
                    {slide.subtitle}
                  </p>
                </div>
              </div>
              <p class="text-neutral-400 font-extrabold md:text-2xl h-30">
                {slide.resume}
              </p>
            </div>
            <div class="h-1/2 mt-auto flex flex-col justify-center items-center gap-10 w-1/3 relative">
              <div class="z-10 mt-2 w-full flex flex-row justify-center absolute top-0">
                {slide.rate >= 9 && <Star size={50} color="#fb2c36" />}
              </div>
              <div
                class={
                  slide?.rate >= 9
                    ? "h-26 w-26 md:h-55 md:w-55 border-6 border-red-500 rounded-full flex flex-col items-center justify-center"
                    : "h-26 w-26 md:h-55 md:w-55 border-6 border-white rounded-full flex flex-col items-center justify-center"
                }
              >
                <div class="flex flex-col gap-2 relative">
                  <p
                    class={
                      slide?.rate >= 9
                        ? "text-red-500 text-4xl md:text-[6rem] font-extrabold"
                        : "text-white text-4xl md:text-[6rem] font-extrabold"
                    }
                  >
                    {slide?.rate?.toFixed(1)}
                  </p>
                </div>
              </div>
            </div>
          </div>
        )}
        <div class="absolute inset-0 shadow-[inset_0_-150px_200px_50px_#0a0a0a] pointer-events-none z-10" />
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>(".carousel").forEach((carousel) => {
    const slides = carousel.querySelectorAll<HTMLElement>(".carousel-slide");
    const interval = Number(carousel.dataset.interval) || 4000;
    let current = 0;

    if (slides.length <= 1) return;

    setInterval(() => {
      slides[current].style.opacity = "0";
      current = (current + 1) % slides.length;
      slides[current].style.opacity = "1";
    }, interval);
  });
</script>
