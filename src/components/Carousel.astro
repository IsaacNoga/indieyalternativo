---
import Star from "./Star.astro";

export interface Slide {
  mediaRoute: string;
  alt?: string;
  title: string;
  subtitle: string;
  link?: string;
  rate?: number;
  resume: string;
  genre: string;
}

interface Props {
  slides: Slide[];
  interval?: number;
}

const { slides, interval = 10000 } = Astro.props;
const uid = crypto.randomUUID().slice(0, 8);
---

<div
  class="carousel relative w-full h-1/2 lg:h-full overflow-hidden"
  data-carousel-id={uid}
  data-interval={interval}
>
  {
    slides.map((slide, i) => (
      <div
        class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out flex flex-row justify-center"
        style={`opacity: ${i === 0 ? 1 : 0};`}
        data-index={i}
      >
        <img
          src={slide.mediaRoute}
          alt={slide.alt ?? ""}
          class="w-full h-full object-cover brightness-40"
        />

        {(slide.title || slide.link || slide?.subtitle) && slide?.rate && (
          <div class="h-full lg:w-3/4 absolute z-20 bottom-0 pb-5 lg:pb-12 grid grid-cols-1 content-end justify-items-center lg:gap-6 lg:grid-cols-[2fr_1fr] lg:justify-items-stretch lg:items-end md:py-30 md:px-20">
            <div class="order-2 lg:order-1 flex flex-col lg:gap-2 justify-end p-5 w-full">
              <div class="flex flex-col gap-0 lg:gap-6">
                <div class="flex flex-col gap-1">
                  <div>
                    <a
                      href={`/reviews/${slide?.title.replace(" ", "-")}`}
                      class="w-full bg-red-500 px-1 py-2 lg:px-4 lg:py-2 rounded-4xl font-bold uppercase text-xs lg:text-lg"
                    >
                      Ver más
                    </a>
                  </div>
                  <p class="text-red-500 font-extrabold text-xs md:text-2xl">
                    {slide.genre}
                  </p>
                </div>
                <div class="flex flex-col lg:gap-2">
                  <p class="w-full text-white text-lg text-justify md:text-6xl title">
                    {slide.title}
                  </p>
                  <p class="text-white text-lg md:text-4xl font-extrabold">
                    {slide.subtitle}
                  </p>
                </div>
              </div>
              <p class="text-neutral-400 font-extrabold text-clip text-xs md:text-xl h-15 lg:h-30">
                {slide.resume}
              </p>
            </div>

            <div class="order-1 lg:order-2 relative flex flex-col justify-center items-center lg:self-center pt-10 lg:pt-0">
              <div class="z-10 w-full flex flex-row justify-center absolute top-3 lg:-top-16">
                {slide.rate >= 9 && (
                  <Star class="size-6 lg:size-14" color="#fb2c36" />
                )}
              </div>
              <div
                class={
                  slide?.rate >= 9
                    ? "h-30 w-30 md:h-55 md:w-55 border-4 lg:border-6 border-red-500 rounded-full flex flex-col items-center justify-center"
                    : "h-30 w-30 md:h-55 md:w-55 border-4 lg:border-6 border-white rounded-full flex flex-col items-center justify-center"
                }
              >
                <p
                  class={
                    slide?.rate >= 9
                      ? "text-red-500 text-5xl md:text-[5rem] font-extrabold"
                      : "text-white text-5xl md:text-[5rem] font-extrabold"
                  }
                >
                  {slide?.rate?.toFixed(1)}
                </p>
              </div>
            </div>
          </div>
        )}
        <div class="absolute inset-0 shadow-[inset_0_-150px_200px_50px_#0a0a0a] pointer-events-none z-10" />
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>(".carousel").forEach((carousel) => {
    const slides = carousel.querySelectorAll<HTMLElement>(".carousel-slide");
    const dots = carousel.querySelectorAll<HTMLButtonElement>(".carousel-dot");
    const fills = carousel.querySelectorAll<HTMLElement>(".carousel-fill");
    const interval = Number(carousel.dataset.interval) || 4000;
    let current = 0;
    let animation: Animation | undefined;
    let timer: ReturnType<typeof setTimeout> | undefined;

    if (slides.length <= 1) return;

    const syncBars = () => {
      fills.forEach((fill, i) => {
        fill.style.transform = `scaleX(${i < current ? 1 : 0})`;
      });
    };

    const playFill = () => {
      animation?.cancel();
      clearTimeout(timer);

      const fill = fills[current];
      if (fill) {
        animation = fill.animate(
          [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }],
          { duration: interval, easing: "linear", fill: "forwards" },
        );
        animation.onfinish = () => goTo(current + 1);
      } else {
        timer = setTimeout(() => goTo(current + 1), interval);
      }
    };

    const goTo = (index: number) => {
      animation?.cancel();
      slides[current].style.opacity = "0";

      current = (index + slides.length) % slides.length;

      slides[current].style.opacity = "1";
      syncBars();
      playFill();
    };

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        if (i !== current) goTo(i);
      });
    });

    playFill();
  });
</script>
