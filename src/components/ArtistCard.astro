---
import Star from "./Star.astro";

interface Props {
  src: string;
  name?: string;
  rate?: number;
}
const { src, name, rate } = Astro.props;
---

<div class="w-140 shrink-0 flex flex-col relative">
  <div class="w-full flex flex-row gap-2 justify-end p-4 z-20 absolute top-0">
    <div class="w-20 h-20 flex flex-row justify-center items-center rounded-full border-3 border-red-500 backdrop-blur-xl">
      {rate && rate >= 9 && <Star size={20} color="#fb2c36" />}
      <p class="text-red-500 text-4xl font-semibold text-shadow-lg">
        {rate}
      </p>
    </div>
  </div>
  <div class="aspect-video w-full overflow-hidden">
    <img
      src={src}
      alt={name}
      class="w-full h-full object-cover object-center hover:brightness-75 transition-all ease-in-out duration-200 cursor-pointer"
    />
  </div>
  <div class="flex flex-col gap-0 z-20 absolute mt-0 bottom-0 w-full p-5">
    <p class="text-xl font-extrabold text-red-500 text-shadow-lg title">POP</p>
    <p class="text-3xl font-extrabold text-white text-shadow-lg">
      {name}
    </p>
  </div>
  <div
    class="absolute inset-0 shadow-[inset_0_-150px_200px_50px_#0a0a0a] pointer-events-none z-10"
  >
  </div>
</div>
