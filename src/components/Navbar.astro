---
import Grain from "./Grain.astro";
import Star from "./Star.astro";
---

<header
  id="navbar"
  class="navbar h-16 w-full flex flex-row justify-between items-center gap-5 fixed top-0 py-2 px-10 z-50 text-white transition-colors duration-500 ease-in-out"
>
  <Grain opacity={0.01} />
  <div class="h-full flex flex-row items-center gap-2">
    <img src="/img/main_logo.png" class="h-full" />
    <p class="font-extrabold">INDIE Y ALTERNATIVO</p>
  </div>
  <div class="flex flex-row gap-10 items-center">
    <a
      class="font-bold hover:text-red-500 transition-colors ease-in-out duration-300 flex flex-row gap-1"
      href="/reseñas"
    >
      <Star size={22} />
      <p>RESEÑAS</p>
    </a>
    <a
      class="font-bold hover:text-red-500 transition-colors ease-in-out duration-300 flex flex-row gap-1"
      href="/noticias"
    >
      <Star size={22} />
      <p>NOTICIAS</p>
    </a>
    <a
      class="font-bold hover:text-red-500 transition-colors ease-in-out duration-300 flex flex-row gap-1"
      href="/reseñas"
    >
      <Star size={22} />

      TOP CHARTS</a
    >
    <a
      class="font-bold hover:text-red-500 transition-colors ease-in-out duration-300 flex flex-row gap-1"
      href="/reseñas"
    >
      <Star size={22} />
      <p>GALERÍA</p>
    </a>
  </div>
</header>

<style>
  .navbar {
    background-color: rgba(0, 0, 0, 0.05);
  }
  .navbar.scrolled {
    background-color: white;
    -webkit-backdrop-filter: blur(4px);
    color: #fb2c36;
  }
</style>

<script>
  const navbar = document.getElementById("navbar");

  const onScroll = () => {
    if (window.scrollY > 20) {
      navbar?.classList.add("scrolled");
    } else {
      navbar?.classList.remove("scrolled");
    }
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
