---
interface Props {
  size?: number | string;
  color?: string;
  emptyColor?: string;
  fill?: number;
  class?: string;
}

const {
  size,
  color = "currentColor",
  emptyColor = "none",
  fill = 100,
  class: className = "size-5",
} = Astro.props;

const percent = Math.min(100, Math.max(0, Number(fill) || 0));
const gradientId = `star-fill-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  role="img"
  aria-label={`Estrella rellena al ${percent}%`}
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="0">
      <stop offset={`${percent}%`} stop-color={color}></stop>
      <stop
        offset={`${percent}%`}
        stop-color={emptyColor}
        stop-opacity={emptyColor === "none" ? 0 : 1}
      ></stop>
    </linearGradient>
  </defs>
  <path
    d="M12 2l2.94 6.36 6.96.83-5.15 4.9 1.4 6.91L12 17.77l-6.15 3.23 1.4-6.91-5.15-4.9 6.96-.83L12 2z"
    fill={`url(#${gradientId})`}
    stroke={color}
    stroke-width="1.5"
    stroke-linejoin="round"
  ></path>
</svg>