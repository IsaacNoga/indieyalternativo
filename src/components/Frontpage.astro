---
import Grain from "./Grain.astro";
import Navbar from "./Navbar.astro";
import Carousel from "./Carousel.astro";
import RecentNews from "./RecentNews.astro";
import QuickReviews from "./QuickReviews.astro";
import { reviews } from "../assets/mockreviews";

const frontReviews = reviews.slice(0,4);
---

<div class="w-full h-dvh relative overflow-y-auto scrollbar-none">
  <Grain opacity={0.01} />
  <Navbar transforms={true} />
  <Carousel interval={5000} slides={frontReviews} />
  <QuickReviews />
  <RecentNews />
</div>
