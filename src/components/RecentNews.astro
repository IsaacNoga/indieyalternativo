---
import { news } from "../assets/mockreviews";
import Star from "./Star.astro";

const frontReviews = news.slice(0, 4);
---

<div
  class="w-full min-h-1/2 lg:min-h-full flex flex-col p-4"
>
  <div class="flex flex-row gap-1 pt-4 md:px-6">
    <Star size={34} color="#fb2c36" />
    <p class="text-4xl title text-black">NOTICIAS</p>
  </div>
  <div class="w-full border border-black my-2"></div>
  <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-5">
    <div class="w-full flex flex-col border-b border-red-500 col-span-1">
      <div class="aspect-video w-full overflow-hidden">
        <img
          src={"/img/karolg.webp"}
          alt={"NO ME ARREPIENTO DE SENTIR TANTO"}
          class="w-full h-full object-cover object-center hover:brightness-75 transition-all ease-in-out duration-200 cursor-pointer"
        />
      </div>
      <p class="text-2xl py-2 mt-0 title">
        {"NO ME ARREPIENTO DE SENTIR TANTO"}
      </p>
      <p class="text-sm md:text-lg">
        Tras recibir una divertida propuesta de matrimonio por parte de un
        fanático de 56 años durante su concierto en el SoFi Stadium de Los
        Ángeles, y por unirse mediante su fundación Con Cora a un gran concierto
        benéfico para ayudar en la reconstrucción de zonas afectadas por sismos
        en Colombia
      </p>
      <div class="w-full flex flex-col gap-1 mt-auto">
        <div class="flex flex-row items-center">
          <Star size={20} />
          <p class="text-lg font-bold">...</p>
        </div>
        <p class="text-sm text-neutral-400">12/03/2025</p>
      </div>
    </div>
    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-10 col-span-1">
      {
        frontReviews.map((review) => (
          <a
            href={review?.link}
            class="w-full flex flex-col border-b border-red-500"
          >
            <div class="aspect-video w-full overflow-hidden">
              <img
                src={review?.mediaRoute}
                alt={review?.title}
                class="w-full h-full object-cover object-center hover:brightness-75 transition-all ease-in-out duration-200 cursor-pointer"
              />
            </div>
            <p class="text-md py-2 mt-0 title">{review?.title}</p>
            <div class="w-full flex flex-col gap-1 mt-auto">
              <div class="flex flex-row items-center">
                <Star size={18} />
                <p class="text-sm font-bold">Javier</p>
              </div>
              <p class="text-sm text-neutral-400">12/03/2025</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>
