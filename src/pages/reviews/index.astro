---
import { reviews } from "../../assets/mockreviews";
import Navbar from "../../components/Navbar.astro";
import Star from "../../components/Star.astro";
import Layout from "../../layouts/Layout.astro";
const principalReview = reviews[0];
const top4 = reviews.slice(1, 5);
const frontReviews = reviews.slice(5, -1);
---

<Layout>
  <Navbar transforms={false} />
  <div class="w-full h-full flex flex-col items-center">
    <div class="p-2 w-full md:w-3/4 lg:p-4">
      <p class="text-black text-4xl sm:text-6xl md:text-8xl title">REVIEWS</p>
    </div>
    <div class="w-full border"></div>
    <div class="flex flex-col h-full gap-2 justify-between lg:p-0 lg:w-5/6">
      <div class="w-full flex flex-col lg:flex-row lg:h-150">
        <a href={`/reviews/${principalReview.title.replaceAll(" ","-")}`} class="w-full lg:w-2/3">
          <div class="w-full shrink-0 flex flex-col relative">
            <div
              class="flex flex-col gap-1 lg:gap-2 items-center z-20 absolute top-4 right-4"
            >
              <div class="flex justify-center">
                <Star class="size-4 lg:size-8" color="#fb2c36" />
              </div>
              <div
                class={"w-14 h-14 md:w-30 md:h-30 flex flex-col justify-center items-center rounded-full border-2 md:border-4 border-red-500 backdrop-blur-xl"}
              >
                <p
                  class={"text-red-500 text-3xl sm:text-5xl md:text-8xl font-semibold text-shadow-lg"}
                >
                  {principalReview.rate}
                </p>
              </div>
            </div>
            <div class="aspect-video w-full overflow-hidden">
              <img
                src={principalReview.mediaRoute}
                alt={principalReview.title}
                class="w-full h-full lg:h-150 object-cover object-center hover:brightness-80 transition-all ease-in-out duration-200 cursor-pointer"
              />
            </div>
            <div
              class="flex flex-col gap-0 z-20 absolute mt-0 bottom-0 w-full p-4 md:p-5"
            >
              <p
                class="text-2xl md:text-6xl font-extrabold text-red-500 text-shadow-lg title"
              >
                {principalReview.genre}
              </p>
              <p
                class="text-xl sm:text-2xl md:text-4xl font-extrabold text-white text-shadow-lg"
              >
                {principalReview.title}
              </p>
              <p
                class="hidden sm:block text-base md:text-md text-neutral-300 text-shadow-lg"
              >
                {principalReview.resume}
              </p>
              <p class="text-xs text-neutral-300 text-shadow-lg">BY JAVIER</p>
            </div>
            <div
              class="absolute inset-0 shadow-[inset_0_-100px_150px_30px_#0a0a0a] md:shadow-[inset_0_-150px_200px_50px_#0a0a0a] pointer-events-none z-10"
            >
            </div>
          </div>
        </a>
        <div class="w-full lg:w-1/3 flex flex-col h-full">
          {
            top4.map((review, k) => (
              <a
                href={`/reviews/${review?.title.replaceAll(" ", "-")}`}
                class={
                  k + 1 === frontReviews.length
                    ? "w-full flex-1 flex flex-row p-3 md:p-4 bg-neutral-900 cursor-pointer"
                    : "w-full flex-1 flex flex-row p-3 md:p-4 border-b border-white bg-neutral-900 cursor-pointer"
                }
              >
                <div class="w-1/5 flex flex-row justify-center items-center">
                  <div
                    class={
                      review?.rate >= 9
                        ? "h-12 w-12 md:h-20 md:w-20 flex flex-row justify-center items-center rounded-full border-2 md:border-3 border-red-500 backdrop-blur-xl"
                        : "h-12 w-12 md:h-20 md:w-20 flex flex-row justify-center items-center rounded-full border-2 md:border-3 border-white backdrop-blur-xl"
                    }
                  >
                    <p
                      class={
                        "text-white text-base md:text-3xl font-semibold text-shadow-lg"
                      }
                    >
                      {review?.rate}
                    </p>
                  </div>
                </div>
                <div class="w-4/5 h-full flex flex-col justify-center align-middle">
                  <p class="text-base md:text-lg font-extrabold text-white">
                    {review?.title}
                  </p>
                  <p class="text-xs md:text-sm font-extrabold text-red-500">
                    {review?.genre}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 py-4 px-4 lg:px-0"
      >
        {
          frontReviews.map((review) => (
            <a
              href={`/reviews/${review?.title.replaceAll(" ", "-")}`}
              class="h-auto md:h-120 bg-neutral-900 flex flex-col py-4 gap-2 cursor-pointer shadow-lg"
            >
              <div class="flex items-center gap-3 min-h-15 px-4">
                <div class="relative shrink-0">
                  <div
                    class:list={[
                      "size-12 rounded-full border-2 flex items-center justify-center font-semibold text-xl",
                      review.rate >= 9
                        ? "border-red-500 text-red-500"
                        : "border-white text-white",
                    ]}
                  >
                    {review.rate}
                  </div>
                </div>
                <p class="min-w-0 text-white font-extrabold text-xl">
                  {review.title}
                </p>
              </div>
              <div class="h-60 overflow-hidden relative">
                <img
                  src={review?.mediaRoute}
                  alt={"karlog"}
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="w-full flex flex-row justify-between px-4">
                <p class="title text-red-500 text-lg md:text-xl">
                  {review?.genre}
                </p>
              </div>
              <p class="text-neutral-300 text-sm md:text-md line-clamp-3 px-4 py-1 border-y border-red-500">
                {review?.resume}
              </p>
              <div class="flex flex-row w-full justify-between px-4 py-2">
                <p class="text-neutral-300 text-xs">BY JAVI</p>
                <p class="text-neutral-300 text-xs">08 2026</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
