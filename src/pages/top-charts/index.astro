---
import Navbar from "../../components/Navbar.astro";
import Star from "../../components/Star.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <Navbar transforms={false} />
  <div class="w-full h-full flex flex-col items-center">
    <div class="w-11/12 md:w-3/4 p-4">
      <p class="text-black text-4xl sm:text-6xl md:text-8xl title">
        TOP CHARTS
      </p>
    </div>
    <div class="w-full border"></div>
    <div class="flex flex-col gap-2 w-2/3 p-2">
      <a
        href="/top-charts/top-10-de-la-semana"
        class="flex flex-row gap-2 bg-neutral-900 p-4 cursor-pointer group items-center"
      >
        <Star
          size={50}
          class="fill-white group-hover:fill-red-500 transition-colors ease-in-out duration-200"
        />
        <p
          class="text-white font-extrabold uppercase text-5xl group-hover:text-red-500 transition-colors ease-in-out duration-200"
        >
          top 10 de la semana
        </p>
      </a>
    </div>
  </div>
</Layout>
