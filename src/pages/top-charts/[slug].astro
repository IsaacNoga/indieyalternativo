---
import { reviews } from "../../assets/mockreviews";
import Navbar from "../../components/Navbar.astro";
import Layout from "../../layouts/Layout.astro";

const { slug } = Astro.params;

const title = slug?.replaceAll("-", " ");
---

<Layout>
  <Navbar transforms={false} />
  <div class="w-full h-full flex flex-col items-center scrollbar-none">
    <div class="flex flex-col gap-2 w-full md:w-3/4 items-center">
      <h1 class="font-extrabold text-6xl uppercase title p-4">{title}</h1>
      <div class="border w-full"></div>
      {
        reviews.map((rv, i) => (
          <div class="border p-2 flex flex-col gap-2 w-11/12 md:w-1/2 relative">
            <div class="flex flex-row gap-2 items-center">
              <p class="title rounded-full border-2 border-red-500 h-7 w-7 text-center items-center justify-center">
                {i + 1}
              </p>
              <p class="title text-lg">{rv?.title}</p>
            </div>
            <img
              class="h-full w-full object-cover object-center"
              alt={rv.subtitle}
              src={rv.mediaRoute}
            />
            <div class="flex flex-col p-2 w-full">
              <p class="text-sm md:text-xl font-extrabold">{rv?.resume}</p>
              <div class="border" />
              <p class="text-xs md:text-lg text-end">12/03/2026</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
