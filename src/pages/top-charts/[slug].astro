---
import { reviews } from "../../assets/mockreviews";
import Navbar from "../../components/Navbar.astro";
import Star from "../../components/Star.astro";
import Layout from "../../layouts/Layout.astro";

const { slug } = Astro.params;

const title = slug?.replaceAll("-", " ");
---

<Layout>
  <Navbar transforms={false} />
  <div class="w-full h-full flex flex-col items-center">
    <div class="flex flex-col gap-2 w-11/12 md:w-3/4 p-4 items-center">
      <h1 class="font-extrabold text-6xl uppercase title">{title}</h1>
      <div class="border-2"></div>
      {
        reviews.map((rv, i) => (
          <div class="border p-2 flex flex-col gap-2 w-11/12 md:w-1/2 relative">
            <img
              class="h-full w-full object-cover object-center"
              alt={rv.subtitle}
              src={rv.mediaRoute}
            />
            <p class="z-20 absolute right-13.5 top-10 md:right-27 md:top-23 text-4xl md:text-6xl title">
              {i + 1}
            </p>
            <Star
              class="size-20 md:size-40 z-10 absolute right-5 top-5 md:right-10 md:top-10"
              color="#fb2c36"
            />
            <div class="flex flex-col p-2 w-2/3">
              <div class="flex flex-col justify-between w-full">
                <p class="font-bold text-lg">{rv?.title}</p>
                <p class="font-bold text-xs">12/03/2026</p>
              </div>
              <div class="border" />
              <p>{rv?.resume}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
