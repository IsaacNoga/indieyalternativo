---
import { news } from "../../assets/mockreviews";
import Navbar from "../../components/Navbar.astro";
import Star from "../../components/Star.astro";
import Layout from "../../layouts/Layout.astro";

const frontReviews = news;
---

<Layout>
  <Navbar transforms={false} />
  <div class="w-full h-full flex flex-col items-center">
    <div class="w-11/12 md:w-3/4 p-4">
      <p class="text-black text-4xl sm:text-6xl md:text-8xl title">NOTICIAS</p>
    </div>
    <div class="w-full border"></div>
    <div class="w-2/3 grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="w-full flex flex-col border-b-2 border-red-500 md:col-span-2">
        <div class="aspect-video w-full overflow-hidden">
          <img
            src={"/img/karolg.webp"}
            alt={"NO ME ARREPIENTO DE SENTIR TANTO"}
            class="w-full h-full object-cover object-center hover:brightness-75 transition-all ease-in-out duration-200 cursor-pointer"
          />
        </div>
        <p class="text-2xl py-2 mt-0 title">
          {"NO ME ARREPIENTO DE SENTIR TANTO"}
        </p>
        <p class="text-sm md:text-lg font-extrabold line-clamp-4">
          Tras recibir una divertida propuesta de matrimonio por parte de un
          fanático de 56 años durante su concierto en el SoFi Stadium de Los
          Ángeles, y por unirse mediante su fundación Con Cora a un gran
          concierto benéfico para ayudar en la reconstrucción de zonas afectadas
          por sismos en Colombia
        </p>
        <div class="w-full flex flex-col gap-1 mt-auto pt-2">
          <div class="flex flex-row items-center">
            <Star size={20} />
            <p class="text-lg font-bold">Javier</p>
          </div>
          <p class="text-sm text-neutral-400">12/03/2025</p>
        </div>
      </div>
      <div class="w-full flex flex-col gap-5 md:col-span-1">
        {
          frontReviews.slice(0, 2).map((review) => (
            <div class="w-full flex-1 min-h-0 flex flex-col border-b-2 border-red-500">
              <div class="aspect-video w-full overflow-hidden">
                <img
                  src={review?.mediaRoute}
                  alt={review?.mediaAlt}
                  class="w-full h-full object-cover object-center hover:brightness-75 transition-all ease-in-out duration-200 cursor-pointer"
                />
              </div>
              <p class="text-md py-2 mt-0 title line-clamp-2">
                {review?.title}
              </p>
              <div class="w-full flex flex-col gap-1 mt-auto">
                <div class="flex flex-row items-center">
                  <Star size={18} />
                  <p class="text-sm font-bold">Javier</p>
                </div>
                <p class="text-sm text-neutral-400">12/03/2025</p>
              </div>
            </div>
          ))
        }
      </div>
      <div class="md:col-span-3 grid grid-cols-2 md:grid-cols-4 gap-5">
        {
          frontReviews.map((review) => (
            <a href={review?.link} class="w-full border-b-2 border-red-500">
              <div class="aspect-video w-full overflow-hidden">
                <img
                  src={review?.mediaRoute}
                  alt={review?.title}
                  class="w-full h-full object-cover object-center hover:brightness-75 transition-all ease-in-out duration-200 cursor-pointer"
                />
              </div>
              <p class="text-md py-2 mt-0 title">{review?.title}</p>
              <div class="w-full flex flex-col gap-1 mt-auto">
                <div class="flex flex-row items-center">
                  <Star size={18} />
                  <p class="text-sm font-bold">Javier</p>
                </div>
                <p class="text-sm text-neutral-400">12/03/2025</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
