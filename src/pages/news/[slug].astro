---
import { news, reviews } from "../../assets/mockreviews";
import Navbar from "../../components/Navbar.astro";
import Layout from "../../layouts/Layout.astro";

const { slug } = Astro.params;

const title = slug?.replaceAll("-", " ");

const noticia = news.find((r) => r.link === `/news/${slug}`);
---

<Layout>
  <Navbar transforms={false} />
  <div class="w-full h-full flex flex-col items-center scrollbar-none">
    <div class="flex flex-col gap-2 w-full md:w-1/2">
      <div class="w-full flex flex-row items-baseline justify-between">
        <h1 class="font-extrabold text-6xl uppercase title pt-4">{title}</h1>
      </div>
      <div class="border w-full"></div>
      <article class="p-2 flow-root">
        <figure class="float-left mr-4 mb-2 w-full sm:w-80 md:w-120 max-w-full">
          <img
            class="h-120 w-full object-cover object-top"
            alt={noticia?.mediaAlt}
            src={noticia?.mediaRoute}
          />
          <figcaption class="flex flex-row justify-between pt-1">
            <p class="text-xs md:text-lg text-start">Por: Javi</p>
            <p class="text-xs md:text-lg text-start">12/03/2026</p>
          </figcaption>
        </figure>
        <p class="text-sm md:text-xl text-justify">{noticia?.content}</p>
      </article>
    </div>
  </div>
</Layout>
