{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/news/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/news/?$",
			"dest": "_render"
		},
		{
			"src": "^/reviews/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/reviews/?$",
			"dest": "_render"
		},
		{
			"src": "^/top-charts/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/top-charts/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}